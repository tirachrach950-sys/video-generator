# Get your key at https://fal.ai (Dashboard > API Keys). Never put it in frontend code.
FAL_KEY=your_fal_key_here
# Video model to call. Copy the id from the model page on fal.ai.
FAL_MODEL=fal-ai/veo2
# Optional: extra model inputs as JSON, if the model needs different fields.
# FAL_EXTRA_INPUT={"duration":"5s","aspect_ratio":"9:16"}
# Optional but recommended: a private code so strangers cannot spend your money.
ACCESS_CODE=choose-a-secret-code
